{
    "name": "Evolet HRM",
    // PHP 8.4 with the two extensions the image lacks — see the Dockerfile.
    // Node is a feature so the front end is built in the same container.
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    // 8000 is the application, 5173 is Vite while the dev server is running.
    "forwardPorts": [8000, 5173],
    "portsAttributes": {
        "8000": {
            "label": "HRM",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "Vite",
            "onAutoForward": "silent"
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    // postCreateCommand runs once, when the container is made. A container that
    // was made before this file existed — or whose first setup was interrupted —
    // would come back empty on every resume, so each start checks and installs
    // whatever is missing. Nothing to do when everything is already in place.
    "postStartCommand": "[ -d vendor ] && [ -d node_modules ] && [ -f .env ] || bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}
